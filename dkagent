find_env_file() {
    for path in "${ENV_SEARCH_PATHS[@]}"; do
        if [[ -n "$path" && -f "$path" ]]; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# 环境变量收集（KEY=value 行）。
# 安全传递方式：写入临时 --env-file（0600、运行结束即删）传给 docker，避免
# -e KEY=val 形式出现在宿主进程列表（ps）与命令行回显中；同 Key 后写入的覆盖先写入的。
ENV_FILE_LINES=()
ENV_FILE_TEMP=""

build_env_args() {
    local env_file="$1" line
    local -A collected=()
    if [[ -f "$env_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            # 跳过空行和以 # 开头的注释行
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
            # 去掉行首空白字符
            line="${line#"${line%%[![:space:]]*}"}"
            # --env-file 仅支持 KEY=value 行（不含 = 的行跳过）
            [[ "$line" == *=* ]] || continue
            collected["${line%%=*}"]="$line"
        done < "$env_file"
    fi

    # 允许宿主机环境变量覆盖 .env 里的 Key，直接透传进去（后写入 = 覆盖 .env 同名项）
    local var
    for var in ANTHROPIC_API_KEY GEMINI_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY DEEPSEEK_API_KEY; do
        if [[ -n "${!var:-}" ]]; then
            collected["$var"]="${var}=${!var}"
        fi
    done
    ENV_FILE_LINES=("${collected[@]}")
}

# 校验 --port 参数格式（防手误；参数走 DOCKER_ARGS 数组传参无 shell 注入风险，
# 端口上限 / 冲突等最终交给 docker 报错）
# 支持格式: [宿主IP:]宿主端口:容器端口[/tcp|/udp|/sctp]，端口可写范围 8000-8010
validate_port_mapping() {
    local m="$1" s="$1"
    [[ -z "$m" ]] && return 1
    [[ "$m" =~ [[:space:]] ]] && return 1
    # 去掉可选协议后缀
    if [[ "$s" =~ ^(.*)/(tcp|udp|sctp)$ ]]; then
        s="${BASH_REMATCH[1]}"
    fi
    # 去掉可选宿主 IP 前缀（IPv4 或 [IPv6]），注意剩余部分必须始终是唯一捕获组（BASH_REMATCH[1]）
    if [[ "$s" =~ ^\[[0-9a-fA-F:]+\]:(.+)$ ]]; then
        s="${BASH_REMATCH[1]}"
    elif [[ "$s" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}:(.+)$ ]]; then
        s="${BASH_REMATCH[1]}"
    fi
    # 剩余必须是 宿主端口:容器端口
    [[ "$s" =~ ^[0-9]{1,5}(-[0-9]{1,5})?:[0-9]{1,5}(-[0-9]{1,5})?$ ]]
}

# ─── sync 子命令实现（独立、纯手动，绝不耦合 docker run / tmux）────────────
# 设计原则（实测得出）：
#   - 完全手动触发，绝不与 dkagent claude 等容器命令耦合
#   - 遵循 rsync 设计哲学：不设默认 exclude / backup，要保护自己加 -- --exclude=...
#   - 默认显示"将要做什么" + 用户确认（除非 --yes）
#   - 内置重试循环（实测：太平洋链路单次同步可能要 4-8 次重试才连上）
#   - 必带 --partial --partial-dir=.rsync-partial（断点续传，跨海链路必需）
#   - ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=20（10 分钟 keepalive 容忍）

# peers 关联数组：alias → ssh://user@host:port
declare -A SYNC_PEERS=()

# 加载 peers 配置（仿 load_custom_profiles 模式）
load_sync_peers() {
    SYNC_PEERS=()
    local path name url line perm
    for path in "${SYNC_PEERS_PATHS[@]}"; do
        [[ -z "$path" || ! -f "$path" ]] && continue
        # 权限告警：peers 含 SSH 地址，组/其他可读时提示收紧（不阻断）
        perm="$(stat -c '%a' "$path" 2>/dev/null || true)"
        if [[ -n "$perm" && "$perm" != "600" && "$perm" != "400" && "$perm" != "700" ]]; then
            msg warn_sync_peers_perm "$path" "$perm" >&2
        fi
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
            line="${line#"${line%%[![:space:]]*}"}"
            if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_-]*= ]]; then
                name="${line%%=*}"
                url="${line#*=}"
                SYNC_PEERS["$name"]="$url"
            fi
        done < "$path"
    done
}

# 解析 ssh://user@host:port → 设置全局 SYNC_USER/SYNC_HOST/SYNC_PORT
parse_ssh_url() {
    local url="$1" user rest host port
    [[ "$url" == ssh://* ]] && url="${url#ssh://}"
    user="${url%%@*}"
    rest="${url#*@}"
    if [[ "$rest" == *:* ]]; then
        host="${rest%%:*}"
        port="${rest##*:}"
    else
        host="$rest"
        port="22"
    fi
    # 如果 url 不含 @，user 会等于整个 url，回退到当前用户
    [[ -z "$user" || "$user" == "$url" ]] && user="${USER:-$(whoami)}"
    # 安全校验：port 必须是纯数字（防 peers 文件被篡改后注入 ssh 命令）
    if [[ ! "$port" =~ ^[0-9]+$ ]]; then
        msg err_sync_invalid_port "$port" >&2
        exit 1
    fi
    # 安全校验：user/host 字符白名单（会被拼进 user@host 经 ssh/rsync 远端 shell 解析，
    # 空格与元字符即注入面，只放行字母数字与 . _ -）
    if [[ ! "$user" =~ ^[A-Za-z0-9._-]+$ ]]; then
        msg err_sync_bad_ident "$user" >&2
        exit 1
    fi
    if [[ ! "$host" =~ ^[A-Za-z0-9._-]+$ ]]; then
        msg err_sync_bad_ident "$host" >&2
        exit 1
    fi
    SYNC_USER="$user"
    SYNC_HOST="$host"
    SYNC_PORT="$port"
}

# 校验远端路径（rsync 的 user@host:path 会交给远端 shell 解析，空格/元字符是注入面，白名单拒绝）
# 白名单 = 安全 ASCII（字母数字与 / . ~ _ -）+ 全部非 ASCII 字节（0x80-0xFF，涵盖 UTF-8 中文等多字节字符）：
# shell 控制字符/元字符均为 ASCII，放行高字节不扩大注入面；TAB/换行属控制字符仍被拒（映射表为 TSV 格式）
validate_sync_remote_path() {
    local p="$1" LC_ALL=C
    # bash 正则按当前 locale 解释，强制 C locale 才能对高字节区间按字节匹配；模式用 $'...' 保持源码纯 ASCII
    local re=$'^[A-Za-z0-9/._~\x80-\xff-]+$'
    [[ -n "$p" && "$p" =~ $re ]]
}

# 查找当前目录到 peer 的映射，输出 remote-path，找不到返回 1
find_sync_mapping() {
    local peer="$1" cwd="$PWD" local_path m_peer remote_path
    [[ ! -f "$SYNC_MAPPING_PATH" ]] && return 1
    while IFS=$'\t' read -r local_path m_peer remote_path; do
        [[ -z "$local_path" || "$local_path" =~ ^[[:space:]]*# ]] && continue
        if [[ "$local_path" == "$cwd" && "$m_peer" == "$peer" ]]; then
            echo "$remote_path"
            return 0
        fi
    done < "$SYNC_MAPPING_PATH"
    return 1
}

# 添加/更新映射（同 local_path + peer 视为更新）
save_sync_mapping() {
    local local_path="$1" peer="$2" remote_path="$3" tmp
    mkdir -p "$(dirname "$SYNC_MAPPING_PATH")"
    if [[ ! -f "$SYNC_MAPPING_PATH" ]]; then
        cat > "$SYNC_MAPPING_PATH" <<'HEADER'
# dkagent sync 项目路径映射表（脚本自动管理 + 可手动 vi 编辑）
# 格式: <本地路径><TAB><peer别名><TAB><远端路径>
HEADER
    fi
    # 移除已存在的同名映射（同 local_path + peer），再追加
    tmp="$(mktemp)"
    awk -F'\t' -v lp="$local_path" -v p="$peer" \
        '$1 != lp || $2 != p' "$SYNC_MAPPING_PATH" > "$tmp" 2>/dev/null || true
    printf '%s\t%s\t%s\n' "$local_path" "$peer" "$remote_path" >> "$tmp"
    mv "$tmp" "$SYNC_MAPPING_PATH"
    chmod 600 "$SYNC_MAPPING_PATH"
}

# 检查 dkagent-sync 镜像是否存在 + 指纹校验（持久化卷同步必需）
# 指纹（镜像 ID）首次使用时记录；此后每次校验一致才放行。
# 防御场景：攻击者拿到 docker 访问权（如经 --docker-socket）用恶意 Dockerfile 重建同名
# 镜像——下次 sync 时容器内代码即可窃取挂载进去的 SSH 身份文件。
check_sync_image() {
    if ! docker image inspect "$SYNC_IMAGE" &>/dev/null; then
        msg sync_no_image "$SYNC_IMAGE" >&2
        msg sync_image_build_hint "$SYNC_IMAGE" >&2
        return 1
    fi
    local cur_id saved_id
    cur_id="$(docker image inspect "$SYNC_IMAGE" --format '{{.Id}}' 2>/dev/null)" || return 1
    if [[ ! -f "$SYNC_IMAGE_ID_FILE" ]]; then
        mkdir -p "$(dirname "$SYNC_IMAGE_ID_FILE")"
        printf '%s\n' "$cur_id" > "$SYNC_IMAGE_ID_FILE"
        chmod 600 "$SYNC_IMAGE_ID_FILE"
        msg sync_image_pinned "${cur_id:0:19}"
    elif ! saved_id="$(cat "$SYNC_IMAGE_ID_FILE" 2>/dev/null)" || [[ "$saved_id" != "$cur_id" ]]; then
        msg err_sync_image_changed >&2
        msg err_sync_image_changed_hint "$SYNC_IMAGE_ID_FILE" >&2
        return 1
    fi
    return 0
}

# 持久化卷同步（容器嵌套 rsync over ssh）
# 用法: sync_volume <direction> <user> <host> <port> <local_vol> <remote_vol> <retries> <dry> [rsync 附加参数...]
sync_volume() {
    local direction="$1" user="$2" host="$3" port="$4"
    local local_vol="$5" remote_vol="$6" retries="${7:-10}" dry="${8:-false}"
    shift 8
    local extra_args=("$@")  # 用户经 -- 透传的 rsync 附加参数
    local ssh_opts="-p ${port} -o StrictHostKeyChecking=accept-new -o ConnectTimeout=30 -o ServerAliveInterval=30 -o ServerAliveCountMax=20"
    # 与 rsync 原生默认一致：不删远端独有文件；需要镜像一致时由用户经 -- 显式透传 --delete
    local base_args=(-az --numeric-ids --partial --partial-dir=.rsync-partial --stats)
    if [[ "$dry" == true ]]; then
        base_args+=(--dry-run -i)
        retries=1  # dry-run 不重试，断了直接报错
    fi

    local local_mount remote_rsync_path src dst
    if [[ "$direction" == "push" ]]; then
        # push: 本地只读 /data:ro 防误写，远端可写
        local_mount="${local_vol}:/data:ro"
        remote_rsync_path="docker run --rm -i -v ${remote_vol}:/data ${SYNC_IMAGE}"
        src="/data/"
        dst="${user}@${host}:/data/"
    else  # pull: 本地可写，远端只读 /data:ro
        local_mount="${local_vol}:/data"
        remote_rsync_path="docker run --rm -i -v ${remote_vol}:/data:ro ${SYNC_IMAGE}"
        src="${user}@${host}:/data/"
        dst="/data/"
    fi

    # SSH 凭据最小化挂载（不再整目录挂 ~/.ssh，缩小镜像被替换时的凭据暴露面）：
    #   - 有 agent（SSH_AUTH_SOCK）时只挂 agent socket，私钥文件不进容器
    #   - 无 agent 时经 ssh -G 解析本机 ssh 实际会用的身份文件，只挂这些私钥（:ro）
    #   - known_hosts 可写挂载（首连新 peer 由 accept-new 自动落盘回宿主机，无告警；私钥仍只读）
    local ssh_mount_args=() id_opts="" idfile idbase
    if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
        ssh_mount_args+=(-v "${SSH_AUTH_SOCK}:${SSH_AUTH_SOCK}" -e "SSH_AUTH_SOCK=${SSH_AUTH_SOCK}")
    else
        while IFS= read -r idfile; do
            # ssh -G 输出的路径可能带未展开的 ~，替换为绝对路径再检查/挂载
            idfile="${idfile/#\~/$HOME}"
            [[ -f "$idfile" ]] || continue
            idbase="$(basename "$idfile")"
            ssh_mount_args+=(-v "${idfile}:/root/.ssh/${idbase}:ro")
            id_opts+=" -o IdentityFile=/root/.ssh/${idbase}"
        done < <(ssh -G -p "$port" "${user}@${host}" 2>/dev/null \
                 | awk 'tolower($1)=="identityfile"{ $1=""; sub(/^[ \t]+/,""); print }' | sort -u)
    fi
    if [[ -f "$HOME/.ssh/known_hosts" ]]; then
        ssh_mount_args+=(-v "${HOME}/.ssh/known_hosts:/root/.ssh/known_hosts")
    fi

    local attempt
    for attempt in $(seq 1 "$retries"); do
        [[ "$dry" == false ]] && msg sync_attempt "$attempt" "$retries"
        if docker run --rm -i \
            -v "$local_mount" \
            ${ssh_mount_args[@]+"${ssh_mount_args[@]}"} \
            "$SYNC_IMAGE" \
            "${base_args[@]}" \
            "${extra_args[@]}" \
            -e "ssh $ssh_opts${id_opts}" \
            --rsync-path="$remote_rsync_path" \
            "$src" "$dst"; then
            [[ "$dry" == false ]] && msg sync_attempt_success "$attempt"
            return 0
        else
            if [[ "$dry" == true ]]; then
                return 1
            fi
            msg sync_attempt_failed "30"
            sleep 30
        fi
    done
    return 1
}

# 项目目录同步（直连 rsync over ssh，不走容器）
# 用法: sync_dir <direction> <user> <host> <port> <local_dir> <remote_dir> <retries> <dry> [rsync 附加参数...]
sync_dir() {
    local direction="$1" user="$2" host="$3" port="$4"
    local local_dir="$5" remote_dir="$6" retries="${7:-10}" dry="${8:-false}"
    shift 8
    local extra_args=("$@")  # 用户经 -- 透传的 rsync 附加参数
    local ssh_opts="-p ${port} -o StrictHostKeyChecking=accept-new -o ConnectTimeout=30 -o ServerAliveInterval=30 -o ServerAliveCountMax=20"
    # 与 rsync 原生默认一致：不删远端独有文件；需要镜像一致时由用户经 -- 显式透传 --delete
    local base_args=(-az --numeric-ids --partial --partial-dir=.rsync-partial --stats)
    if [[ "$dry" == true ]]; then
        base_args+=(--dry-run -i)
        retries=1
    fi

    local src dst
    if [[ "$direction" == "push" ]]; then
        src="${local_dir}/"
        dst="${user}@${host}:${remote_dir}/"
    else
        src="${user}@${host}:${remote_dir}/"
        dst="${local_dir}/"
    fi

    local attempt
    for attempt in $(seq 1 "$retries"); do
        [[ "$dry" == false ]] && msg sync_attempt "$attempt" "$retries"
        if rsync "${base_args[@]}" \
            "${extra_args[@]}" \
            -e "ssh $ssh_opts" \
            "$src" "$dst"; then
            [[ "$dry" == false ]] && msg sync_attempt_success "$attempt"
            return 0
        else
            if [[ "$dry" == true ]]; then
                return 1
            fi
            msg sync_attempt_failed "30"
            sleep 30
        fi
    done
    return 1
}

# sync list 子命令（可选传 peer 过滤映射）
dkagent_sync_list() {
    if [[ $# -gt 1 ]]; then
        msg err_sync_unexpected_arg "$2" >&2
        exit 1
    fi
    local peer_filter="${1:-}"
    load_sync_peers
    msg sync_listing_peers
    if [[ ${#SYNC_PEERS[@]} -eq 0 ]]; then
        echo "  $(msg sync_no_peers_configured)"
    else
        local name
        for name in "${!SYNC_PEERS[@]}"; do
            printf "  %-15s\t%s\n" "$name" "${SYNC_PEERS[$name]}"
        done | sort
    fi
    echo ""
    msg sync_listing_mapping_cwd
    # 列出当前目录的所有映射（可指定 peer 过滤）；修复：无 peer 参数时也能正确列出
    local found=false local_path m_peer remote_path
    if [[ -f "$SYNC_MAPPING_PATH" ]]; then
        while IFS=$'\t' read -r local_path m_peer remote_path; do
            [[ -z "$local_path" || "$local_path" =~ ^[[:space:]]*# ]] && continue
            if [[ "$local_path" == "$PWD" && ( -z "$peer_filter" || "$m_peer" == "$peer_filter" ) ]]; then
                printf "  %s\t→ [%s] %s\n" "$PWD" "$m_peer" "$remote_path"
                found=true
            fi
        done < "$SYNC_MAPPING_PATH"
    fi
    [[ "$found" == false ]] && echo "  $(msg sync_no_mapping_for_cwd)"
}

# sync push/pull 总入口
dkagent_sync_xfer() {
    local direction="$1"; shift
    local peer_alias="" remote_path_opt="" no_volume=false no_project=false
    local assume_yes=false dry_run_only=false retries=10
    local rsync_extra_args=()  # -- 之后透传给 rsync 的附加参数（保持参数边界，勿拼字符串）

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --remote-path)
                [[ $# -lt 2 ]] && { msg err_opt_needs_arg "--remote-path" >&2; exit 1; }
                remote_path_opt="$2"; shift 2 ;;
            --no-volume)    no_volume=true; shift ;;
            --no-project)   no_project=true; shift ;;
            -y|--yes)       assume_yes=true; shift ;;
            --dry-run)      dry_run_only=true; shift ;;
            --retries)
                [[ $# -lt 2 ]] && { msg err_opt_needs_arg "--retries" >&2; exit 1; }
                if [[ ! "$2" =~ ^[0-9]+$ ]]; then
                    msg err_sync_invalid_retries "$2" >&2
                    exit 1
                fi
                retries="$2"; shift 2 ;;
            --)
                # rsync 附加参数透传（如 -- --exclude=.git/），必须位于最后
                shift
                rsync_extra_args=("$@")
                break ;;
            -h|--help)      print_sync_help; exit 0 ;;
            -*)
                msg err_unknown_opt "$1" >&2; exit 1 ;;
            *)
                # 第一个非 flag 参数是 peer 别名
                if [[ -z "$peer_alias" ]]; then
                    peer_alias="$1"
                else
                    msg err_sync_unexpected_arg "$1" >&2; exit 1
                fi
                shift ;;
        esac
    done

    if [[ -z "$peer_alias" ]]; then
        msg err_sync_peer_required >&2
        exit 1
    fi
    if [[ "$no_volume" == true && "$no_project" == true ]]; then
        msg sync_no_volume_no_project >&2
        exit 1
    fi

    # 加载 peers 配置
    load_sync_peers
    if [[ ${#SYNC_PEERS[@]} -eq 0 ]]; then
        msg sync_no_peers_file "${SYNC_PEERS_PATHS[0]}" >&2
        exit 1
    fi
    if [[ -z "${SYNC_PEERS[$peer_alias]:-}" ]]; then
        msg sync_no_peer "$peer_alias" "${!SYNC_PEERS[*]}" >&2
        exit 1
    fi

    # 解析 peer URL → SYNC_USER/SYNC_HOST/SYNC_PORT
    parse_ssh_url "${SYNC_PEERS[$peer_alias]}"

    # 项目目录同步的 remote 路径解析
    local local_dir="$PWD" remote_dir="" skip_project="$no_project"
    if [[ "$skip_project" == false ]]; then
        if [[ -n "$remote_path_opt" ]]; then
            remote_dir="$remote_path_opt"
        elif remote_dir="$(find_sync_mapping "$peer_alias")"; then
            : # 找到映射，直接用
        else
            msg sync_no_mapping_skip >&2
            skip_project=true
        fi
        # 安全校验：远端路径字符白名单（--remote-path 与映射表文件统一把关，
        # 经 rsync 远端 shell 传递，拒绝空格与元字符；中文等非 ASCII 字节放行，见 validate_sync_remote_path；
        # 必须在 save_sync_mapping 之前）
        if [[ "$skip_project" == false ]] && ! validate_sync_remote_path "$remote_dir"; then
            msg err_sync_bad_path "$remote_dir" >&2
            exit 1
        fi
        if [[ -n "$remote_path_opt" ]]; then
            save_sync_mapping "$local_dir" "$peer_alias" "$remote_dir"
            msg sync_remote_path_added "$local_dir" "$peer_alias" "$remote_dir"
        fi
    fi

    # 决定实际操作
    local will_volume=false will_dir=false
    [[ "$no_volume" == false ]] && will_volume=true
    [[ "$skip_project" == false && -n "$remote_dir" ]] && will_dir=true

    # 显示预览 + 确认（除非 --yes 或 --dry-run）
    # --dry-run 模式：直接跑 dry-run（不修改数据，不需要确认）
    if [[ "$dry_run_only" == true ]]; then
        msg sync_dryrun_intro
        if [[ "$will_volume" == true ]]; then
            check_sync_image || exit 1
            sync_volume "$direction" "$SYNC_USER" "$SYNC_HOST" "$SYNC_PORT" \
                "$HOME_VOLUME" "$HOME_VOLUME" 1 true "${rsync_extra_args[@]}" || true
        fi
        if [[ "$will_dir" == true ]]; then
            sync_dir "$direction" "$SYNC_USER" "$SYNC_HOST" "$SYNC_PORT" \
                "$local_dir" "$remote_dir" 1 true "${rsync_extra_args[@]}" || true
        fi
        exit 0
    fi

    if [[ "$assume_yes" == false ]]; then
        echo ""
        if [[ "$will_volume" == true ]]; then
            if [[ "$direction" == "push" ]]; then
                msg sync_volume_pushing "$HOME_VOLUME" "${SYNC_USER}@${SYNC_HOST}"
            else
                msg sync_volume_pulling "$HOME_VOLUME" "${SYNC_USER}@${SYNC_HOST}"
            fi
        fi
        if [[ "$will_dir" == true ]]; then
            if [[ "$direction" == "push" ]]; then
                msg sync_dir_pushing "$local_dir" "${SYNC_USER}@${SYNC_HOST}" "$remote_dir"
            else
                msg sync_dir_pulling "$local_dir" "${SYNC_USER}@${SYNC_HOST}" "$remote_dir"
            fi
        fi
        echo ""
        msg sync_confirm_prompt
        local response
        read -r response || true
        if [[ ! "$response" =~ ^[Yy]$ ]]; then
            msg sync_aborted
            exit 0
        fi
    fi

    # 实际同步（带重试循环）
    if [[ "$will_volume" == true ]]; then
        check_sync_image || exit 1
        sync_volume "$direction" "$SYNC_USER" "$SYNC_HOST" "$SYNC_PORT" \
            "$HOME_VOLUME" "$HOME_VOLUME" "$retries" false "${rsync_extra_args[@]}" || exit 1
    fi

    if [[ "$will_dir" == true ]]; then
        sync_dir "$direction" "$SYNC_USER" "$SYNC_HOST" "$SYNC_PORT" \
            "$local_dir" "$remote_dir" "$retries" false "${rsync_extra_args[@]}" || exit 1
    fi

    msg sync_done
}

# ─── sync 子命令路由（必须在主参数解析 while 循环之前）────────────────────
# 完全绕开 tmux 块（470 行）和 docker run 主流程（759 行）。sync 是纯本地配置/网络操作。
if [[ "${1:-}" == "sync" ]]; then
    shift
    SYNC_ACTION="${1:-}"
    [[ -n "$SYNC_ACTION" ]] && shift
    case "$SYNC_ACTION" in
        push|pull)
            dkagent_sync_xfer "$SYNC_ACTION" "$@"
            exit 0
            ;;
        list)
            dkagent_sync_list "$@"
            exit 0
            ;;
        ""|-h|--help)
            print_sync_help
            exit 0
            ;;
        *)
            msg sync_unknown_action "$SYNC_ACTION" >&2
            print_sync_help >&2
            exit 1
            ;;
    esac
fi

# ─── 解析参数 ────────────────────────────────────────────

USE_PERSISTENT_HOME=true
MOUNT_MODE="PWD" # PWD, CUSTOM, NONE
MOUNT_DIRS=()    # 每个元素: "/path/to/dir:rw" 或 "/path/to/dir:ro"
PORT_MAPS=()     # 端口映射（--port 可重复），每个元素: docker -p 语法，如 "8080:8080" 或 "127.0.0.1:3000:3000"
CUSTOM_ENV=""
DRY_RUN=false
AGENT_CMD=""
EXTRA_ARGS=()
# 镜像选择：--image > --profile > $DKAGENT_PROFILE > 默认
CUSTOM_IMAGE=""     # --image 指定的镜像名（最高优先级）
SELECTED_PROFILE="" # --profile 指定的 profile 名
ENABLE_DOCKER=false # --docker-socket: 挂载宿主 docker.sock，让容器内可运行 docker 命令
NET_MODE=""        # --net: 网络模式（空 = 默认 bridge；host = --network host 共享宿主网络）
# tmux 包装（默认开启：SSH 断线后进程保留，手动 tmux attach 重连）；保存原始 argv 供内层重入使用
ORIGINAL_ARGV=("$@")
ENABLE_TMUX=true    # 默认开启宿主机 tmux 包装（--no-tmux 关闭）
TMUX_SESSION=""     # 自定义 tmux 会话名（空 = 自动按工作目录命名为 dkagent-<basename>）

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        --lang)
            if [[ $# -lt 2 ]]; then
                msg err_opt_needs_arg "--lang" >&2
                exit 1
            fi
            CURRENT_LANG="$2"
            shift 2
            ;;
        -p|--profile)
            if [[ $# -lt 2 ]]; then
                msg err_opt_needs_arg "-p/--profile" >&2
                exit 1
            fi
            SELECTED_PROFILE="$2"
            shift 2
            ;;
        --image)
            if [[ $# -lt 2 ]]; then
                msg err_opt_needs_arg "--image" >&2
                exit 1
            fi
            CUSTOM_IMAGE="$2"
            shift 2
            ;;
        -e|--ephemeral)
            USE_PERSISTENT_HOME=false
            shift
            ;;
        -m|--mount)
            if [[ $# -lt 2 ]]; then
                msg err_opt_needs_arg "-m/--mount" >&2
                exit 1
            fi
            MOUNT_MODE="CUSTOM"
            # 按空格拆分，支持 -m "./a ./b" 和 -m ./a 两种形式
            for dir in $2; do
                MOUNT_DIRS+=("$(cd "$dir" 2>/dev/null && pwd || echo "$dir"):rw")
            done
            shift 2
            ;;
        -r|--readonly)
            if [[ ${#MOUNT_DIRS[@]} -eq 0 ]]; then
                msg err_readonly_no_mount >&2
                exit 1
            fi
            # 将最后一个元素的 :rw 改为 :ro
            last_idx=$(( ${#MOUNT_DIRS[@]} - 1 ))
            last_entry="${MOUNT_DIRS[$last_idx]}"
            if [[ "$last_entry" != *":rw" ]]; then
                msg err_readonly_not_writable >&2
                exit 1
            fi
            MOUNT_DIRS[$last_idx]="${last_entry%:rw}:ro"
            shift
            ;;
        --no-mount)
            MOUNT_MODE="NONE"
            MOUNT_DIRS=()
            shift
            ;;
        --env)
            if [[ $# -lt 2 ]]; then
                msg err_opt_needs_arg "--env" >&2
                exit 1
            fi
            CUSTOM_ENV="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --docker-socket)
            ENABLE_DOCKER=true
            shift
            ;;
        --port)
            if [[ $# -lt 2 ]]; then
                msg err_opt_needs_arg "--port" >&2
                exit 1
            fi
            if ! validate_port_mapping "$2"; then
                msg err_port_invalid "$2" >&2
                exit 1
            fi
            PORT_MAPS+=("$2")
            shift 2
            ;;
        --net)
            if [[ $# -lt 2 ]]; then
                msg err_opt_needs_arg "--net" >&2
                exit 1
            fi
            case "$2" in
                host) NET_MODE="host" ;;
                off)  NET_MODE="off" ;;
                *)
                    msg err_net_mode_invalid "$2" >&2
                    exit 1
                    ;;
            esac
            shift 2
            ;;
        --no-tmux)
            ENABLE_TMUX=false
            shift
            ;;
        --tmux-name)
            if [[ $# -lt 2 ]]; then
                msg err_opt_needs_arg "--tmux-name" >&2
                exit 1
            fi
            TMUX_SESSION="$2"
            shift 2
            ;;
        -*)
            msg err_unknown_opt "$1" >&2
            msg err_see_help >&2
            exit 1
            ;;
        *)
            # sync 子命令：即使出现在 --lang 等全局选项之后也能识别（不当作 AGENT_CMD）
            if [[ "$1" == "sync" ]]; then
                shift
                SYNC_ACTION="${1:-}"
                [[ -n "$SYNC_ACTION" ]] && shift
                case "$SYNC_ACTION" in
                    push|pull)
                        dkagent_sync_xfer "$SYNC_ACTION" "$@"; exit 0 ;;
                    list)
                        dkagent_sync_list "$@"; exit 0 ;;
                    ""|-h|--help)
                        print_sync_help; exit 0 ;;
                    *)
                        msg sync_unknown_action "$SYNC_ACTION" >&2
                        print_sync_help >&2
                        exit 1
                        ;;
                esac
            fi
            AGENT_CMD="$1"
            shift
            EXTRA_ARGS=("$@")
            break
            ;;
    esac
done

# ─── tmux 包装（远程 SSH 会话断线重连）──────────────────
# 宿主机层包装：tmux server 跑在宿主机，SSH 断线不影响，docker 进程继续跑。
# 每次运行都新建独立 session；断线重连由用户手动 `tmux attach -t <name>` 完成。
# 放在参数解析后、.env/镜像检测前：外层 dkagent 只负责包装，配置信息由 tmux 内层打印一次。
# 条件：开启 + 非 dry-run + 不在 tmux 内(避免嵌套) + 非递归重入 + 是 tty + 宿主机装了 tmux
if [[ "$ENABLE_TMUX" == true \
      && "$DRY_RUN" == false \
      && -z "${TMUX:-}" \
      && -z "${DKAGENT_TMUX_GUARD:-}" \
      && -t 1 \
      && -n "$(command -v tmux 2>/dev/null)" ]]; then
    # 会话名优先级: --tmux-name > $DKAGENT_TMUX_SESSION > dkagent-<当前目录名>
    TMUX_SESSION_NAME="${TMUX_SESSION:-${DKAGENT_TMUX_SESSION:-dkagent-$(basename "$PWD")}}"
    # tmux 把 ':' 和 '.' 当作 target 分隔符（session:window.pane），会静默替换成 '_'
    # 这会导致含这两个字符的目录名（如 project.bak / project:v2）在 attach 时找不到会话。
    # 主动替换，确保会话名合法。
    TMUX_SESSION_NAME="${TMUX_SESSION_NAME//[:.]/_}"
    # 重名处理：同名 session 已存在时自动加序号后缀（_2 _3 ...），避免串台/报错
    FINAL_NAME="$TMUX_SESSION_NAME"
    n=2
    while tmux has-session -t "$FINAL_NAME" 2>/dev/null; do
        FINAL_NAME="${TMUX_SESSION_NAME}_${n}"
        n=$((n+1))
    done
    if [[ "$FINAL_NAME" != "$TMUX_SESSION_NAME" ]]; then
        msg tmux_wrapping_renamed "$TMUX_SESSION_NAME" "$FINAL_NAME" "$FINAL_NAME"
    else
        msg tmux_wrapping "$FINAL_NAME" "$FINAL_NAME"
    fi
    # 用 %q 安全转义每个参数（tmux 经 sh -c 重新解析命令行，转义可防参数错切/注入）
    QUOTED_ARGV=()
    for arg in "${ORIGINAL_ARGV[@]}"; do
        QUOTED_ARGV+=("$(printf '%q' "$arg")")
    done
    # new-session（无 -A）+ -c "$PWD"：
    #   - -c "$PWD" 强制 pane cwd = 调用者 cwd，修复内层 $(pwd) 取错目录的 bug
    #   - 不用 -A，每次新建独立 session；重连由用户手动 `tmux attach -t <name>`
    # 哨兵 DKAGENT_TMUX_GUARD 防递归；--no-tmux 跳过二次包装
    exec tmux new-session -s "$FINAL_NAME" -c "$PWD" \
        env DKAGENT_TMUX_GUARD=1 \
        dkagent --no-tmux "${QUOTED_ARGV[@]}"
fi

# 显式 --no-tmux（非 re-exec 重入）：提示后果
if [[ "$ENABLE_TMUX" == false && -z "${DKAGENT_TMUX_GUARD:-}" ]]; then
    msg tmux_no_tmux >&2
fi

# ─── .env 文件检测 ──────────────────────────────────────

if [[ -n "$CUSTOM_ENV" ]]; then
    if [[ ! -f "$CUSTOM_ENV" ]]; then
        msg err_env_not_exist "$CUSTOM_ENV" >&2
        exit 1
    fi
    ENV_FILE="$CUSTOM_ENV"
else
    if ENV_FILE=$(find_env_file); then
        : # 正常找到
    else
        ENV_FILE=""
    fi
fi

if [[ -n "$ENV_FILE" ]]; then
    msg using_env_file "$ENV_FILE"
    build_env_args "$ENV_FILE"
else
    msg no_env_file >&2
    build_env_args ""
fi

# ─── 解析最终使用的镜像 ─────────────────────────────────
# 优先级: --image > --profile > $DKAGENT_PROFILE > $DEFAULT_PROFILE

DOCKER_IMAGE=""
EFFECTIVE_PROFILE=""

if [[ -n "$CUSTOM_IMAGE" ]]; then
    # --image 最高优先级，直接用
    DOCKER_IMAGE="$CUSTOM_IMAGE"
    # 反查是否匹配某个 profile（仅用于显示）
    for name in "${!PROFILE_IMAGES[@]}"; do
        if [[ "${PROFILE_IMAGES[$name]}" == "$DOCKER_IMAGE" ]]; then
            EFFECTIVE_PROFILE="$name"
            break
        fi
    done
else
    # 确定 profile 名: --profile > 环境变量 > 默认
    EFFECTIVE_PROFILE="${SELECTED_PROFILE:-${DKAGENT_PROFILE:-$DEFAULT_PROFILE}}"
    if [[ -z "${PROFILE_IMAGES[$EFFECTIVE_PROFILE]:-}" ]]; then
        msg err_profile_unknown "$EFFECTIVE_PROFILE" >&2
        msg err_profile_available "${!PROFILE_IMAGES[*]}" >&2
        msg err_profile_hint >&2
        exit 1
    fi
    DOCKER_IMAGE="${PROFILE_IMAGES[$EFFECTIVE_PROFILE]}"
fi

if [[ -n "$EFFECTIVE_PROFILE" ]]; then
    msg using_image_with_profile "$DOCKER_IMAGE" "$EFFECTIVE_PROFILE"
else
    msg using_image "$DOCKER_IMAGE"
fi

# ─── 检查 Docker 镜像是否存在 ─────────────────────────────

if ! docker image inspect "$DOCKER_IMAGE" &>/dev/null; then
    msg err_image_not_found "$DOCKER_IMAGE" >&2
    msg err_image_build_hint >&2
    msg err_image_build_kali >&2
    msg err_image_build_slim >&2
    if [[ -n "$EFFECTIVE_PROFILE" && "$EFFECTIVE_PROFILE" != "kali" && "$EFFECTIVE_PROFILE" != "slim" ]]; then
        msg err_image_build_custom "$EFFECTIVE_PROFILE" "$DOCKER_IMAGE" >&2
    fi
    exit 1
fi

# ─── 构建 docker run 参数 ────────────────────────────────

DOCKER_ARGS=(
    "docker" "run" "--rm" "-it"
)

# 0. 容器名：基于当前目录，参考 tmux 命名逻辑处理重名
#    - 默认名: dkagent-<basename($PWD)>（挂载多目录不影响命名，跟 tmux 一致只看 $PWD）
#    - 同目录多个 dkagent 运行中: 加 _2 _3 ... 后缀
#    - Docker 容器名规范 [a-zA-Z0-9][a-zA-Z0-9_.-]+，特殊字符替换为 _
#    - 安全 escape hatch:
#        DKAGENT_CONTAINER_NAME=xxx  自定义容器名
#        DKAGENT_NO_CONTAINER_NAME=1 禁用命名（回到 Docker 随机名）
#    可见性等同 tmux session 名（本地 docker 组成员能在 `docker ps` 看到）
if [[ "${DKAGENT_NO_CONTAINER_NAME:-}" != "1" ]]; then
    CONTAINER_NAME_BASE="${DKAGENT_CONTAINER_NAME:-dkagent-$(basename "$PWD")}"
    # 把非 [a-zA-Z0-9_.-] 字符替换为 _（含中文目录名等），保证 Docker 接受
    CONTAINER_NAME_BASE="$(printf '%s' "$CONTAINER_NAME_BASE" | sed 's/[^a-zA-Z0-9_.-]/_/g')"
    # Docker 要求首字符是字母数字，否则前面补 'x'
    [[ "$CONTAINER_NAME_BASE" =~ ^[a-zA-Z0-9] ]] || CONTAINER_NAME_BASE="x${CONTAINER_NAME_BASE}"
    # 长度保险截断（Docker 允许 200+，这里 80 足够）
    CONTAINER_NAME_BASE="${CONTAINER_NAME_BASE:0:80}"

    if [[ -n "$CONTAINER_NAME_BASE" ]]; then
        FINAL_CONTAINER_NAME="$CONTAINER_NAME_BASE"
        n=2
        # 仅检查运行中的容器（--rm 模式下退出即清理，停止的容器名是历史残留不阻塞）
        while docker ps --filter "name=^${FINAL_CONTAINER_NAME}$" --format '{{.Names}}' 2>/dev/null | grep -q .; do
            FINAL_CONTAINER_NAME="${CONTAINER_NAME_BASE}_${n}"
            n=$((n+1))
        done
        if [[ "$FINAL_CONTAINER_NAME" != "$CONTAINER_NAME_BASE" ]]; then
            msg container_name_renamed "$CONTAINER_NAME_BASE" "$FINAL_CONTAINER_NAME"
        else
            msg container_name_set "$FINAL_CONTAINER_NAME"
        fi
        DOCKER_ARGS+=("--name" "$FINAL_CONTAINER_NAME")
    fi
fi

# 1. 挂载 Home 卷 (持久化 vs 临时)
if [[ "$USE_PERSISTENT_HOME" == true ]]; then
    DOCKER_ARGS+=("-v" "${HOME_VOLUME}:/home/kali")
    msg mode_persistent_home
else
    msg mode_ephemeral_home
fi

# 2. 挂载工作目录及工作目录设定
if [[ "$MOUNT_MODE" == "PWD" ]]; then
    MOUNT_DIRS=("$(pwd):rw")
elif [[ "$MOUNT_MODE" == "NONE" ]]; then
    MOUNT_DIRS=()
fi

# basename 冲突检测
declare -A SEEN_BASENAMES=()
for entry in "${MOUNT_DIRS[@]}"; do
    dir_path="${entry%:*}"
    base_name="$(basename "$dir_path")"
    if [[ -n "${SEEN_BASENAMES[$base_name]:-}" ]]; then
        msg err_basename_conflict "$base_name" >&2
        echo "  - ${SEEN_BASENAMES[$base_name]}" >&2
        echo "  - ${dir_path}" >&2
        exit 1
    fi
    SEEN_BASENAMES["$base_name"]="$dir_path"
done

# 目录存在性检查 + 挂载构建
if [[ ${#MOUNT_DIRS[@]} -gt 0 ]]; then
    # tmpfs 覆盖 workspace，避免持久化 home 时残留旧挂载目录
    DOCKER_ARGS+=("--tmpfs" "${CONTAINER_WORKSPACE}:noexec")
    # 单目录挂载 → 工作目录直接进入该挂载目录
    # 多目录挂载 → 工作目录停留在 workspace 根目录
    if [[ ${#MOUNT_DIRS[@]} -eq 1 ]]; then
        single_base="$(basename "${MOUNT_DIRS[0]%:*}")"
        DOCKER_ARGS+=("-w" "${CONTAINER_WORKSPACE}/${single_base}")
    else
        DOCKER_ARGS+=("-w" "${CONTAINER_WORKSPACE}")
    fi
    for entry in "${MOUNT_DIRS[@]}"; do
        dir_path="${entry%:*}"
        access="${entry##*:}"
        base_name="$(basename "$dir_path")"
        if [[ ! -d "$dir_path" ]]; then
            msg err_dir_not_exist "$dir_path" >&2
            exit 1
        fi
        abs_path="$(cd "$dir_path" 2>/dev/null && pwd)"
        DOCKER_ARGS+=("-v" "${abs_path}:${CONTAINER_WORKSPACE}/${base_name}:${access}")
    done
else
    DOCKER_ARGS+=("-w" "${CONTAINER_WORKSPACE}")
fi

# 2.5 挂载宿主 docker.sock（--docker-socket 模式，让容器内可运行 docker 命令）
if [[ "$ENABLE_DOCKER" == true ]]; then
    # sock 路径发现：环境变量覆盖 > DOCKER_HOST 解析 > 常见路径探测 > 兜底
    DOCKER_SOCK="${DKAGENT_DOCKER_SOCK:-}"
    if [[ -z "$DOCKER_SOCK" ]]; then
        case "${DOCKER_HOST:-}" in
            unix://*) DOCKER_SOCK="${DOCKER_HOST#unix://}" ;;
        esac
    fi
    if [[ -z "$DOCKER_SOCK" ]]; then
        for cand in /var/run/docker.sock /run/docker.sock \
                    "$HOME/.docker/run/docker.sock" \
                    "/mnt/wsl/docker-desktop/shared-sockets/guest-services/docker.sock"; do
            [[ -S "$cand" ]] && { DOCKER_SOCK="$cand"; break; }
        done
    fi
    [[ -z "$DOCKER_SOCK" ]] && DOCKER_SOCK="/var/run/docker.sock"
    # 校验 sock 存在
    if [[ ! -S "$DOCKER_SOCK" ]]; then
        msg err_docker_sock_not_found "$DOCKER_SOCK" >&2
        msg err_docker_sock_hint >&2
        exit 1
    fi
    DOCKER_ARGS+=("-v" "${DOCKER_SOCK}:/var/run/docker.sock")
    # docker.sock 通常是 0660 root:docker，容器内 kali 用户需加入宿主 docker 组才能访问
    DOCKER_GID="$(getent group docker 2>/dev/null | cut -d: -f3)"
    if [[ -n "$DOCKER_GID" ]]; then
        DOCKER_ARGS+=("--group-add" "$DOCKER_GID")
    fi
fi

# 2.8 端口映射（--port 可重复，跟随 docker run -p 原生语义，绑定地址默认 0.0.0.0）
for mapping in "${PORT_MAPS[@]}"; do
    DOCKER_ARGS+=("-p" "$mapping")
    msg port_publish "$mapping"
done

# 2.9 网络模式（--net host = --network host：共享宿主网络命名空间，
#     容器内 127.0.0.1 即宿主 127.0.0.1，只绑 loopback 的服务（如 dsh web 默认）
#     无需端口映射即可直接访问；此时 --port 会被 docker 忽略）
#     与 --docker-socket 同理：无网络隔离属高风险操作，启动前必须打印风险提示
#     --net off = --network none：容器无任何网络接口，外网/宿主端口全不可达（最安全档，
#     实测可阻断 Docker Desktop 的 host.docker.internal 宿主回环通道）
if [[ "$NET_MODE" == "host" ]]; then
    msg warn_net_host_risk
    DOCKER_ARGS+=("--network" "host")
    if [[ ${#PORT_MAPS[@]} -gt 0 ]]; then
        msg warn_net_host_port
    fi
elif [[ "$NET_MODE" == "off" ]]; then
    DOCKER_ARGS+=("--network" "none")
    if [[ ${#PORT_MAPS[@]} -gt 0 ]]; then
        msg warn_net_off_port
    fi
fi

# 3. 打印安全风险信息
HAS_WRITABLE=false
HAS_READONLY=false
for entry in "${MOUNT_DIRS[@]}"; do
    access="${entry##*:}"
    if [[ "$access" == "rw" ]]; then
        HAS_WRITABLE=true
    else
        HAS_READONLY=true
    fi
done

if [[ ${#MOUNT_DIRS[@]} -eq 0 ]]; then
    if [[ "$USE_PERSISTENT_HOME" == true ]]; then
        msg risk_iso_persistent
    else
        msg risk_iso_ephemeral
    fi
elif [[ "$HAS_WRITABLE" == false ]]; then
    msg mount_readonly_count "${#MOUNT_DIRS[@]}" "$CONTAINER_WORKSPACE"
    for entry in "${MOUNT_DIRS[@]}"; do
        dir_path="${entry%:*}"
        abs_path="$(cd "$dir_path" 2>/dev/null && pwd)"
        msg mount_detail_ro "$abs_path"
    done
else
    msg mount_writable_count "${#MOUNT_DIRS[@]}" "$CONTAINER_WORKSPACE"
    for entry in "${MOUNT_DIRS[@]}"; do
        dir_path="${entry%:*}"
        access="${entry##*:}"
        abs_path="$(cd "$dir_path" 2>/dev/null && pwd)"
        if [[ "$access" == "ro" ]]; then
            msg mount_detail_ro "$abs_path"
        else
            msg mount_detail_rw "$abs_path"
        fi
    done
fi

# docker.sock 挂载是无条件最高风险（等同宿主 root），叠加警示
if [[ "$ENABLE_DOCKER" == true ]]; then
    msg risk_docker_escape
fi

# 4. 环境变量经临时 --env-file 传递（0600、用后即删；避免 -e KEY=val 出现在宿主 ps 与 dry-run 回显）
if [[ ${#ENV_FILE_LINES[@]} -gt 0 ]]; then
    ENV_FILE_TEMP="$(mktemp /tmp/dkagent-env.XXXXXX)"
    chmod 600 "$ENV_FILE_TEMP"
    printf '%s\n' "${ENV_FILE_LINES[@]}" > "$ENV_FILE_TEMP"
    # 信号/退出时清理临时凭据文件（见下方执行段：不再用 exec 替换进程，保证 trap 可运行）
    trap 'rm -f "$ENV_FILE_TEMP"' EXIT
    trap 'rm -f "$ENV_FILE_TEMP"; exit 130' INT
    trap 'rm -f "$ENV_FILE_TEMP"; exit 143' TERM
    DOCKER_ARGS+=("--env-file" "$ENV_FILE_TEMP")
fi

# 5. 指定镜像名称
DOCKER_ARGS+=("$DOCKER_IMAGE")

# 6. 指定要执行的命令
if [[ -n "$AGENT_CMD" ]]; then
    # agent 名即容器内命令名（claude/pi/codex/opencode/agy/dsh 等），不做别名映射
    # 用 -f 跳过全部 zsh 启动文件（.zshenv/.zprofile/.zshrc）：
    # 持久化 Home 卷可能被注入恶意启动文件，-lc（登录 shell）会无条件 source .zshenv，
    # 使后门在 --no-mount 等"看似隔离"的模式下仍然执行；交互 shell（无 agent 参数）
    # 仍读 .zshrc（用户配置场景，属已知权衡）
    DOCKER_ARGS+=("/bin/zsh" "-f" "-c" "${AGENT_CMD} ${EXTRA_ARGS[*]:-}")
else
    DOCKER_ARGS+=("/bin/zsh")
fi

# ─── 执行 ───────────────────────────────────────────────

if [[ "$DRY_RUN" == true ]]; then
    msg dry_run_header
    printf '%q ' "${DOCKER_ARGS[@]}"
    echo -e "\n"
    # 环境变量单独列出：默认打码（值不出现在终端/日志），opt-in 才显明文
    if [[ ${#ENV_FILE_LINES[@]} -gt 0 ]]; then
        if [[ "${DKAGENT_DRY_RUN_SHOW_SECRETS:-}" == "1" ]]; then
            msg dry_run_env_plain
            printf '  %s\n' "${ENV_FILE_LINES[@]}"
        else
            msg dry_run_env_masked
            printf '  %s=***\n' "${ENV_FILE_LINES[@]%%=*}"
        fi
        echo ""
    fi
    exit 0
fi

msg starting
# 不用 exec 替换进程：docker 作为子进程运行，结束后走 EXIT trap 清理 --env-file 临时文件
rc=0
"${DOCKER_ARGS[@]}" || rc=$?
# tmux pane 主进程场景（外层 exec tmux 重入时注入 DKAGENT_TMUX_GUARD=1）：退出后一律停留片刻，
# 否则本进程一退 pane 即销毁，退出前的输出（报错信息或正常收尾）一闪而过；回车立即关，超时自动关
if [[ -n "${DKAGENT_TMUX_GUARD:-}" && "${DKAGENT_EXIT_HOLD_SECS:-10}" != "0" ]]; then
    if [[ "$rc" -eq 0 ]]; then
        msg exit_hold_done "${DKAGENT_EXIT_HOLD_SECS:-10}"
    else
        msg exit_hold_prompt "$rc" "${DKAGENT_EXIT_HOLD_SECS:-10}"
    fi
    read -r -t "${DKAGENT_EXIT_HOLD_SECS:-10}" || true
fi
exit "$rc"
