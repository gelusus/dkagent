#!/usr/bin/env bash
#
# dkagent - AI Agent Docker 统一运行入口
#
# 用法:
#   dkagent                           # 默认模式：持久化 home + 挂载当前目录，进入 zsh
#   dkagent claude                    # 启动并直接运行 claude
#   dkagent -e claude                 # 🧊 临时/干净模式 + 直接运行 claude
#   dkagent -m ./project claude       # 🟡 沙盒模式，挂载指定目录并运行
#   dkagent -m "./a ./b" claude       # 🟠 多目录挂载（全部可写），启动 Claude
#   dkagent -m "./a ./b" -r -r claude # 🟡 多目录只读挂载，启动 Claude
#   dkagent --no-mount                # 🟢 纯配置管理模式，不挂载任何工作目录
#   dkagent --help                    # 查看详细帮助及安全指南
#

set -euo pipefail

# ─── 配置 ───────────────────────────────────────────────
# 默认 profile（作者个人偏好，开源后也是默认档）
DEFAULT_PROFILE="kali"

# 内置 profile → 镜像名映射。用户可在 ~/.config/dkagent/profiles 追加自定义 profile
declare -A PROFILE_IMAGES=(
    ["kali"]="my-kali-agent"          # 默认: 基于 Kali Linux，内置完整安全研究/渗透工具链
    ["slim"]="dkagent-slim"           # 可选: 基于 Debian slim 的精简版，体积小、启动快
)

# 容器内统一路径（所有 profile 共用，保证持久化 Home 卷可跨镜像复用）
CONTAINER_WORKSPACE="/home/kali/workspace"
HOME_VOLUME="agent_docker_kali-home"

# .env 文件搜索路径
ENV_SEARCH_PATHS=(
    "${DKAGENT_ENV:-}"                             # 1. 环境变量指定的路径
    "$HOME/.config/dkagent/.env"                  # 2. XDG 风格全局配置
    "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.env" # 3. 脚本所在目录 (如符号链接)
)

# profile 配置文件搜索路径（每行格式: PROFILE_NAME=image-name）
PROFILE_CONF_PATHS=(
    "$HOME/.config/dkagent/profiles"              # 1. XDG 风格全局配置
    "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/profiles" # 2. 脚本所在目录
)

# 加载自定义 profile（覆盖/追加到内置 PROFILE_IMAGES）
load_custom_profiles() {
    for path in "${PROFILE_CONF_PATHS[@]}"; do
        [[ -z "$path" || ! -f "$path" ]] && continue
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
            line="${line#"${line%%[![:space:]]*}"}"
            # 格式: NAME=image-name
            if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_-]*= ]]; then
                local name="${line%%=*}"
                local image="${line#*=}"
                PROFILE_IMAGES["$name"]="$image"
            fi
        done < "$path"
    done
}
load_custom_profiles

# ─── 函数 ───────────────────────────────────────────────

print_help() {
    cat <<'EOF'
dkagent - AI Agent Docker 统一运行入口

用法:
  dkagent [选项] [agent名称] [附加参数...]

Agent 名称:
  claude        启动 Claude Code
  gemini        启动 Gemini CLI
  pi            启动 Pi Coding Agent
  codex         启动 OpenAI Codex
  opencode      启动 OpenCode
  (留空)         进入交互式 zsh shell

选项:
  -p, --profile NAME     🎚️ 选择镜像 profile（默认: kali）
                         内置: kali（完整工具链）、slim（精简 Debian）
                         可通过 ~/.config/dkagent/profiles 添加自定义 profile
  --image NAME           🐳 直接指定 Docker 镜像名（优先级高于 --profile）
  -e, --ephemeral        🧊 使用临时 home 目录（不保留任何配置或历史记录，防注入更安全）
  -m, --mount DIR        📁 挂载指定目录到 /home/kali/workspace/<目录名>
                         支持多次指定: -m ./a -m ./b
                         支持空格分隔: -m "./a ./b"
  -r, --readonly         🔒 紧跟 -m 之后使用，将前一个 -m 目录以只读方式挂载
  --no-mount             🟢 不挂载任何工作目录（完全无法触碰宿主机文件，最安全）
  --docker-socket        🐋 挂载宿主 docker.sock，让容器内可运行 docker 命令
                         ⚠️ 最高风险：等同把宿主机 root 权限交给容器
  --env FILE             指定特定的 .env 文件路径
  --dry-run              仅打印 docker run 命令而不实际启动容器
  -h, --help             显示此帮助信息及安全警告

镜像优先级: --image > --profile > 环境变量 DKAGENT_PROFILE > 默认(kali)

安全等级说明 (⚠ 请谨慎选择):
  风险等级由 挂载模式 × Home持久化 组合决定:

  🟢 隔离级别  : --no-mount + -e  (完全隔离，用完即焚)
  🟢 低风险    : --no-mount       (隔离宿主文件，持久化 home 有配置被改风险)
  🟢 低风险    : 全只读挂载 + -e  (只能读取，退出不留痕)
  🟡 中低风险  : 全只读挂载       (只能读取，但持久化 home 有配置被改风险)
  🟡 中风险    : 有可写挂载 + -e  (可操作挂载目录，退出不留痕)
  🔴 高风险    : 有可写挂载       (可操作挂载目录 + 持久化 home 可留后门)
  ☠️ 逃逸级别  : --docker-socket  (docker.sock = 宿主 root，无视上述档位)

示例:
  dkagent                                    # 挂载当前目录到 workspace/<basename>
  dkagent claude                             # 挂载当前目录，直接启动 Claude
  dkagent -e claude                          # 🧊 临时 home + 挂载当前目录
  dkagent -m ./project-a -m ./project-b      # 挂载多个目录
  dkagent -m ./original -r -m ./copy claude  # 原始目录只读，副本可读写
  dkagent --no-mount                         # 🟢 不挂载任何目录
  dkagent --env ~/custom.env                 # 使用自定义的 .env 配置文件
  dkagent -p slim claude                     # 🎚️ 使用精简镜像运行 Claude
  dkagent --image my-custom-agent claude     # 🐳 使用任意自定义镜像
  dkagent --docker-socket claude             # 🐋 容器内可用 docker（⚠️ 最高风险）
EOF
}

find_env_file() {
    for path in "${ENV_SEARCH_PATHS[@]}"; do
        if [[ -n "$path" && -f "$path" ]]; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# 全局环境变量参数数组，避免 Word Splitting Bug
ENV_DOCKER_ARGS=()

build_env_args() {
    local env_file="$1"
    if [[ -f "$env_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            # 跳过空行和以 # 开头的注释行
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
            # 去掉行首空白字符
            line="${line#"${line%%[![:space:]]*}"}"
            ENV_DOCKER_ARGS+=("-e" "$line")
        done < "$env_file"
    fi

    # 允许宿主机环境变量覆盖 .env 里的 Key，直接透传进去
    for var in ANTHROPIC_API_KEY GEMINI_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY; do
        if [[ -n "${!var:-}" ]]; then
            ENV_DOCKER_ARGS+=("-e" "${var}=${!var}")
        fi
    done
}

# ─── 解析参数 ────────────────────────────────────────────

USE_PERSISTENT_HOME=true
MOUNT_MODE="PWD" # PWD, CUSTOM, NONE
MOUNT_DIRS=()    # 每个元素: "/path/to/dir:rw" 或 "/path/to/dir:ro"
CUSTOM_ENV=""
DRY_RUN=false
AGENT_CMD=""
EXTRA_ARGS=()
# 镜像选择：--image > --profile > $DKAGENT_PROFILE > 默认
CUSTOM_IMAGE=""     # --image 指定的镜像名（最高优先级）
SELECTED_PROFILE="" # --profile 指定的 profile 名
ENABLE_DOCKER=false # --docker-socket: 挂载宿主 docker.sock，让容器内可运行 docker 命令

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        -p|--profile)
            if [[ $# -lt 2 ]]; then
                echo "❌ 错误: -p/--profile 选项需要提供 profile 名称！" >&2
                exit 1
            fi
            SELECTED_PROFILE="$2"
            shift 2
            ;;
        --image)
            if [[ $# -lt 2 ]]; then
                echo "❌ 错误: --image 选项需要提供镜像名称！" >&2
                exit 1
            fi
            CUSTOM_IMAGE="$2"
            shift 2
            ;;
        -e|--ephemeral)
            USE_PERSISTENT_HOME=false
            shift
            ;;
        -m|--mount)
            if [[ $# -lt 2 ]]; then
                echo "❌ 错误: -m/--mount 选项需要提供目录参数！" >&2
                exit 1
            fi
            MOUNT_MODE="CUSTOM"
            # 按空格拆分，支持 -m "./a ./b" 和 -m ./a 两种形式
            for dir in $2; do
                MOUNT_DIRS+=("$(cd "$dir" 2>/dev/null && pwd || echo "$dir"):rw")
            done
            shift 2
            ;;
        -r|--readonly)
            if [[ ${#MOUNT_DIRS[@]} -eq 0 ]]; then
                echo "❌ 错误: -r/--readonly 必须跟在 -m 之后使用！" >&2
                exit 1
            fi
            # 将最后一个元素的 :rw 改为 :ro
            last_idx=$(( ${#MOUNT_DIRS[@]} - 1 ))
            last_entry="${MOUNT_DIRS[$last_idx]}"
            if [[ "$last_entry" != *":rw" ]]; then
                echo "❌ 错误: -r/--readonly 只能对可读写目录使用！" >&2
                exit 1
            fi
            MOUNT_DIRS[$last_idx]="${last_entry%:rw}:ro"
            shift
            ;;
        --no-mount)
            MOUNT_MODE="NONE"
            MOUNT_DIRS=()
            shift
            ;;
        --env)
            if [[ $# -lt 2 ]]; then
                echo "❌ 错误: --env 选项需要提供文件路径！" >&2
                exit 1
            fi
            CUSTOM_ENV="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --docker-socket)
            ENABLE_DOCKER=true
            shift
            ;;
        -*)
            echo "❌ 未知选项: $1" >&2
            echo "请运行 'dkagent --help' 查看可用选项" >&2
            exit 1
            ;;
        *)
            AGENT_CMD="$1"
            shift
            EXTRA_ARGS=("$@")
            break
            ;;
    esac
done

# ─── .env 文件检测 ──────────────────────────────────────

if [[ -n "$CUSTOM_ENV" ]]; then
    if [[ ! -f "$CUSTOM_ENV" ]]; then
        echo "❌ 指定的 .env 文件不存在: $CUSTOM_ENV" >&2
        exit 1
    fi
    ENV_FILE="$CUSTOM_ENV"
else
    if ENV_FILE=$(find_env_file); then
        : # 正常找到
    else
        ENV_FILE=""
    fi
fi

if [[ -n "$ENV_FILE" ]]; then
    echo "📋 使用配置文件: $ENV_FILE"
    build_env_args "$ENV_FILE"
else
    echo "⚠️  未检测到任何 .env 配置文件，将仅使用当前终端的环境变量" >&2
    build_env_args ""
fi

# ─── 解析最终使用的镜像 ─────────────────────────────────
# 优先级: --image > --profile > $DKAGENT_PROFILE > $DEFAULT_PROFILE

DOCKER_IMAGE=""
EFFECTIVE_PROFILE=""

if [[ -n "$CUSTOM_IMAGE" ]]; then
    # --image 最高优先级，直接用
    DOCKER_IMAGE="$CUSTOM_IMAGE"
    # 反查是否匹配某个 profile（仅用于显示）
    for name in "${!PROFILE_IMAGES[@]}"; do
        if [[ "${PROFILE_IMAGES[$name]}" == "$DOCKER_IMAGE" ]]; then
            EFFECTIVE_PROFILE="$name"
            break
        fi
    done
else
    # 确定 profile 名: --profile > 环境变量 > 默认
    EFFECTIVE_PROFILE="${SELECTED_PROFILE:-${DKAGENT_PROFILE:-$DEFAULT_PROFILE}}"
    if [[ -z "${PROFILE_IMAGES[$EFFECTIVE_PROFILE]:-}" ]]; then
        echo "❌ 错误: 未知的 profile '$EFFECTIVE_PROFILE'。" >&2
        echo "可用 profile: ${!PROFILE_IMAGES[*]}" >&2
        echo "提示: 可通过 --image <镜像名> 直接指定任意镜像，或在 ~/.config/dkagent/profiles 添加自定义 profile。" >&2
        exit 1
    fi
    DOCKER_IMAGE="${PROFILE_IMAGES[$EFFECTIVE_PROFILE]}"
fi

echo "📦 使用镜像: $DOCKER_IMAGE${EFFECTIVE_PROFILE:+ (profile: $EFFECTIVE_PROFILE)}"

# ─── 检查 Docker 镜像是否存在 ─────────────────────────────

if ! docker image inspect "$DOCKER_IMAGE" &>/dev/null; then
    echo "❌ 错误: 本地找不到 Docker 镜像 '$DOCKER_IMAGE'。" >&2
    echo "请先构建该镜像。内置 profile 的构建方式:" >&2
    echo "  kali  → 在项目主目录运行 'docker compose build'" >&2
    echo "  slim  → 运行 'docker build -t dkagent-slim -f dockerfiles/Dockerfile.slim .'" >&2
    if [[ -n "$EFFECTIVE_PROFILE" && "$EFFECTIVE_PROFILE" != "kali" && "$EFFECTIVE_PROFILE" != "slim" ]]; then
        echo "  '$EFFECTIVE_PROFILE' 是自定义 profile，请用对应方式构建镜像 '$DOCKER_IMAGE'。" >&2
    fi
    exit 1
fi

# ─── 构建 docker run 参数 ────────────────────────────────

DOCKER_ARGS=(
    "docker" "run" "--rm" "-it"
)

# 1. 挂载 Home 卷 (持久化 vs 临时)
if [[ "$USE_PERSISTENT_HOME" == true ]]; then
    DOCKER_ARGS+=("-v" "${HOME_VOLUME}:/home/kali")
    echo "🏠 模式: 持久化 Home (保留工具配置、自动补全及命令历史)"
else
    echo "🧊 模式: 临时 Home (纯净环境，安全无污染)"
fi

# 2. 挂载工作目录及工作目录设定
if [[ "$MOUNT_MODE" == "PWD" ]]; then
    MOUNT_DIRS=("$(pwd):rw")
elif [[ "$MOUNT_MODE" == "NONE" ]]; then
    MOUNT_DIRS=()
fi

# basename 冲突检测
declare -A SEEN_BASENAMES=()
for entry in "${MOUNT_DIRS[@]}"; do
    dir_path="${entry%:*}"
    base_name="$(basename "$dir_path")"
    if [[ -n "${SEEN_BASENAMES[$base_name]:-}" ]]; then
        echo "❌ 错误: 目录名冲突！多个路径的 basename 均为 '${base_name}':" >&2
        echo "  - ${SEEN_BASENAMES[$base_name]}" >&2
        echo "  - ${dir_path}" >&2
        exit 1
    fi
    SEEN_BASENAMES["$base_name"]="$dir_path"
done

# 目录存在性检查 + 挂载构建
if [[ ${#MOUNT_DIRS[@]} -gt 0 ]]; then
    # tmpfs 覆盖 workspace，避免持久化 home 时残留旧挂载目录
    DOCKER_ARGS+=("--tmpfs" "${CONTAINER_WORKSPACE}:noexec")
    # 单目录挂载 → 工作目录直接进入该挂载目录
    # 多目录挂载 → 工作目录停留在 workspace 根目录
    if [[ ${#MOUNT_DIRS[@]} -eq 1 ]]; then
        single_base="$(basename "${MOUNT_DIRS[0]%:*}")"
        DOCKER_ARGS+=("-w" "${CONTAINER_WORKSPACE}/${single_base}")
    else
        DOCKER_ARGS+=("-w" "${CONTAINER_WORKSPACE}")
    fi
    for entry in "${MOUNT_DIRS[@]}"; do
        dir_path="${entry%:*}"
        access="${entry##*:}"
        base_name="$(basename "$dir_path")"
        if [[ ! -d "$dir_path" ]]; then
            echo "❌ 错误: 指定的挂载目录不存在: $dir_path" >&2
            exit 1
        fi
        abs_path="$(cd "$dir_path" 2>/dev/null && pwd)"
        DOCKER_ARGS+=("-v" "${abs_path}:${CONTAINER_WORKSPACE}/${base_name}:${access}")
    done
else
    DOCKER_ARGS+=("-w" "${CONTAINER_WORKSPACE}")
fi

# 2.5 挂载宿主 docker.sock（--docker-socket 模式，让容器内可运行 docker 命令）
if [[ "$ENABLE_DOCKER" == true ]]; then
    # sock 路径发现：环境变量覆盖 > DOCKER_HOST 解析 > 常见路径探测 > 兜底
    DOCKER_SOCK="${DKAGENT_DOCKER_SOCK:-}"
    if [[ -z "$DOCKER_SOCK" ]]; then
        case "${DOCKER_HOST:-}" in
            unix://*) DOCKER_SOCK="${DOCKER_HOST#unix://}" ;;
        esac
    fi
    if [[ -z "$DOCKER_SOCK" ]]; then
        for cand in /var/run/docker.sock /run/docker.sock \
                    "$HOME/.docker/run/docker.sock" \
                    "/mnt/wsl/docker-desktop/shared-sockets/guest-services/docker.sock"; do
            [[ -S "$cand" ]] && { DOCKER_SOCK="$cand"; break; }
        done
    fi
    [[ -z "$DOCKER_SOCK" ]] && DOCKER_SOCK="/var/run/docker.sock"
    # 校验 sock 存在
    if [[ ! -S "$DOCKER_SOCK" ]]; then
        echo "❌ 错误: --docker-socket 找不到 docker socket: $DOCKER_SOCK" >&2
        echo "提示: 可通过 DKAGENT_DOCKER_SOCK 环境变量指定 sock 路径" >&2
        exit 1
    fi
    DOCKER_ARGS+=("-v" "${DOCKER_SOCK}:/var/run/docker.sock")
    # docker.sock 通常是 0660 root:docker，容器内 kali 用户需加入宿主 docker 组才能访问
    DOCKER_GID="$(getent group docker 2>/dev/null | cut -d: -f3)"
    if [[ -n "$DOCKER_GID" ]]; then
        DOCKER_ARGS+=("--group-add" "$DOCKER_GID")
    fi
fi

# 3. 打印安全风险信息
HAS_WRITABLE=false
HAS_READONLY=false
for entry in "${MOUNT_DIRS[@]}"; do
    access="${entry##*:}"
    if [[ "$access" == "rw" ]]; then
        HAS_WRITABLE=true
    else
        HAS_READONLY=true
    fi
done

if [[ ${#MOUNT_DIRS[@]} -eq 0 ]]; then
    if [[ "$USE_PERSISTENT_HOME" == true ]]; then
        echo "🟢 安全风险: 隔离级别 (未挂载任何宿主机目录，持久化 home 有配置被改风险)"
    else
        echo "🟢 安全风险: 隔离级别 (完全隔离，用完即焚)"
    fi
elif [[ "$HAS_WRITABLE" == false ]]; then
    echo "🟡 安全风险: 只读挂载 (${#MOUNT_DIRS[@]} 个目录以只读方式挂载到 ${CONTAINER_WORKSPACE}/)"
    for entry in "${MOUNT_DIRS[@]}"; do
        dir_path="${entry%:*}"
        abs_path="$(cd "$dir_path" 2>/dev/null && pwd)"
        echo "  → ${abs_path} (只读)"
    done
else
    echo "🔴 安全风险: 映射级别 (${#MOUNT_DIRS[@]} 个目录挂载到 ${CONTAINER_WORKSPACE}/)"
    for entry in "${MOUNT_DIRS[@]}"; do
        dir_path="${entry%:*}"
        access="${entry##*:}"
        abs_path="$(cd "$dir_path" 2>/dev/null && pwd)"
        if [[ "$access" == "ro" ]]; then
            echo "  → ${abs_path} (只读)"
        else
            echo "  → ${abs_path} (可读写)"
        fi
    done
fi

# docker.sock 挂载是无条件最高风险（等同宿主 root），叠加警示
if [[ "$ENABLE_DOCKER" == true ]]; then
    echo "☠️  安全风险: 容器逃逸级别 (已挂载 docker.sock = 宿主机 root，容器内可完全控制宿主 Docker)"
fi

# 4. 塞入环境变量参数
if [[ ${#ENV_DOCKER_ARGS[@]} -gt 0 ]]; then
    DOCKER_ARGS+=("${ENV_DOCKER_ARGS[@]}")
fi

# 5. 指定镜像名称
DOCKER_ARGS+=("$DOCKER_IMAGE")

# 6. 指定要执行的命令
if [[ -n "$AGENT_CMD" ]]; then
    case "$AGENT_CMD" in
        claude|gemini|pi|codex|opencode)
            DOCKER_ARGS+=("/bin/zsh" "-lc" "${AGENT_CMD} ${EXTRA_ARGS[*]:-}")
            ;;
        *)
            # 允许运行任意指令
            DOCKER_ARGS+=("/bin/zsh" "-lc" "${AGENT_CMD} ${EXTRA_ARGS[*]:-}")
            ;;
    esac
else
    DOCKER_ARGS+=("/bin/zsh")
fi

# ─── 执行 ───────────────────────────────────────────────

if [[ "$DRY_RUN" == true ]]; then
    echo -e "\n🔍 Dry-run 模式，实际执行命令如下:"
    printf '%q ' "${DOCKER_ARGS[@]}"
    echo -e "\n"
    exit 0
fi

echo "🐳 正在拉起 AI Agent Docker 运行环境..."
exec "${DOCKER_ARGS[@]}"
