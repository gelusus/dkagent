# 消息查找函数：msg <key> [args...] —— 按 CURRENT_LANG 取消息，支持 %s 占位符替换
msg() {
    local key="$1"; shift
    local template
    if [[ "$CURRENT_LANG" == "en" ]]; then
        template="${MSG_EN[$key]:-}"
    else
        template="${MSG_ZH[$key]:-}"
    fi
    if [[ $# -gt 0 ]]; then
        # shellcheck disable=SC2059  # 模板里的 %s 占位符是故意的
        printf "$template\n" "$@"
    else
        # shellcheck disable=SC2059  # 模板里可能含 \n 等转义，需 printf 解析
        printf "$template\n"
    fi
}

