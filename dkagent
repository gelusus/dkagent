#!/usr/bin/env bash
#
# dkagent - AI Agent Docker 统一运行入口
#
# 用法:
#   dkagent                      # 默认模式：持久化 home + 挂载当前目录，进入 zsh
#   dkagent claude               # 启动并直接运行 claude
#   dkagent -e claude            # 🧊 临时/干净模式 + 直接运行 claude
#   dkagent -m ./project claude  # 🟡 沙盒模式，挂载指定目录的副本并运行
#   dkagent --no-mount           # 🟢 纯配置管理模式，不挂载任何工作目录
#   dkagent --help               # 查看详细帮助及安全指南
#

set -euo pipefail

# ─── 配置 ───────────────────────────────────────────────
DOCKER_IMAGE="my-kali-agent"
CONTAINER_WORKSPACE="/home/kali/workspace"
HOME_VOLUME="agent_docker_kali-home"

# .env 文件搜索路径
ENV_SEARCH_PATHS=(
    "${DKAGENT_ENV:-}"                             # 1. 环境变量指定的路径
    "$HOME/.config/dkagent/.env"                  # 2. XDG 风格全局配置
    "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.env" # 3. 脚本所在目录 (如符号链接)
)

# ─── 函数 ───────────────────────────────────────────────

print_help() {
    cat <<'EOF'
dkagent - AI Agent Docker 统一运行入口

用法:
  dkagent [选项] [agent名称] [附加参数...]

Agent 名称:
  claude        启动 Claude Code
  gemini        启动 Gemini CLI
  pi            启动 Pi Coding Agent
  codex         启动 OpenAI Codex
  opencode      启动 OpenCode
  (留空)         进入交互式 zsh shell

选项:
  -e, --ephemeral        🧊 使用临时 home 目录（不保留任何配置或历史记录，防注入更安全）
  -m, --mount DIR        📁 挂载指定的工作目录，而非当前目录（配合副本实现沙盒隔离）
  --no-mount             🟢 不挂载任何工作目录（完全无法触碰宿主机文件，最安全）
  --env FILE             指定特定的 .env 文件路径
  --dry-run              仅打印 docker run 命令而不实际启动容器
  -h, --help             显示此帮助信息及安全警告

安全等级说明 (⚠ 请谨慎选择):
  🟢 隔离级别 (高) : 使用 --no-mount
                   Agent 完全运行在 Docker 隔离沙盒中，零宿主文件受损风险。
  🟡 沙盒级别 (中) : 使用 -m <副本目录>
                   事先复制你的代码到指定目录再挂载。Agent 只能折腾副本，原始文件绝对安全。
  🔴 映射级别 (低) : 直接运行 (默认挂载 PWD)
                   最便捷，但 Agent 可以对你当前目录下的所有文件执行读/写/删操作。
                   若使用不信任的 Agent 提示词，存在文件被清空的可能！

示例:
  dkagent                           # 挂载当前目录，持久化 home，进入 zsh
  dkagent claude                    # 挂载当前目录，直接启动 Claude
  dkagent -e claude                 # 🧊 临时 home 干净环境 + 挂载当前目录 + 启动 Claude
  dkagent -m ./sandbox_dir claude   # 🟡 沙盒模式下，挂载副本目录并启动 Claude
  dkagent --no-mount                # 🟢 纯 shell，不挂载任何工作目录，管理容器配置
  dkagent --env ~/custom.env        # 使用自定义的 .env 配置文件
EOF
}

find_env_file() {
    for path in "${ENV_SEARCH_PATHS[@]}"; do
        if [[ -n "$path" && -f "$path" ]]; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# 全局环境变量参数数组，避免 Word Splitting Bug
ENV_DOCKER_ARGS=()

build_env_args() {
    local env_file="$1"
    if [[ -f "$env_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            # 跳过空行和以 # 开头的注释行
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
            # 去掉行首空白字符
            line="${line#"${line%%[![:space:]]*}"}"
            ENV_DOCKER_ARGS+=("-e" "$line")
        done < "$env_file"
    fi

    # 允许宿主机环境变量覆盖 .env 里的 Key，直接透传进去
    for var in ANTHROPIC_API_KEY GEMINI_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY; do
        if [[ -n "${!var:-}" ]]; then
            ENV_DOCKER_ARGS+=("-e" "${var}=${!var}")
        fi
    done
}

# ─── 解析参数 ────────────────────────────────────────────

USE_PERSISTENT_HOME=true
MOUNT_MODE="PWD" # PWD, CUSTOM, NONE
MOUNT_DIR=""
CUSTOM_ENV=""
DRY_RUN=false
AGENT_CMD=""
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        -e|--ephemeral)
            USE_PERSISTENT_HOME=false
            shift
            ;;
        -m|--mount)
            if [[ $# -lt 2 ]]; then
                echo "❌ 错误: -m/--mount 选项需要提供目录参数！" >&2
                exit 1
            fi
            MOUNT_MODE="CUSTOM"
            MOUNT_DIR="$2"
            shift 2
            ;;
        --no-mount)
            MOUNT_MODE="NONE"
            shift
            ;;
        --env)
            if [[ $# -lt 2 ]]; then
                echo "❌ 错误: --env 选项需要提供文件路径！" >&2
                exit 1
            fi
            CUSTOM_ENV="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -*)
            echo "❌ 未知选项: $1" >&2
            echo "请运行 'dkagent --help' 查看可用选项" >&2
            exit 1
            ;;
        *)
            AGENT_CMD="$1"
            shift
            EXTRA_ARGS=("$@")
            break
            ;;
    esac
done

# ─── .env 文件检测 ──────────────────────────────────────

if [[ -n "$CUSTOM_ENV" ]]; then
    if [[ ! -f "$CUSTOM_ENV" ]]; then
        echo "❌ 指定的 .env 文件不存在: $CUSTOM_ENV" >&2
        exit 1
    fi
    ENV_FILE="$CUSTOM_ENV"
else
    if ENV_FILE=$(find_env_file); then
        : # 正常找到
    else
        ENV_FILE=""
    fi
fi

if [[ -n "$ENV_FILE" ]]; then
    echo "📋 使用配置文件: $ENV_FILE"
    build_env_args "$ENV_FILE"
else
    echo "⚠️  未检测到任何 .env 配置文件，将仅使用当前终端的环境变量" >&2
    build_env_args ""
fi

# ─── 检查 Docker 镜像是否存在 ─────────────────────────────

if ! docker image inspect "$DOCKER_IMAGE" &>/dev/null; then
    echo "❌ 错误: 本地找不到 Docker 镜像 '$DOCKER_IMAGE'。" >&2
    echo "请在项目主目录下运行 'docker compose build' 构建该镜像后再试！" >&2
    exit 1
fi

# ─── 构建 docker run 参数 ────────────────────────────────

DOCKER_ARGS=(
    "docker" "run" "--rm" "-it"
)

# 1. 挂载 Home 卷 (持久化 vs 临时)
if [[ "$USE_PERSISTENT_HOME" == true ]]; then
    DOCKER_ARGS+=("-v" "${HOME_VOLUME}:/home/kali")
    echo "🏠 模式: 持久化 Home (保留工具配置、自动补全及命令历史)"
else
    echo "🧊 模式: 临时 Home (纯净环境，安全无污染)"
fi

# 2. 挂载工作目录及工作目录设定
HOST_WORKSPACE_PATH=""
if [[ "$MOUNT_MODE" == "PWD" ]]; then
    HOST_WORKSPACE_PATH="$(pwd)"
    DOCKER_ARGS+=("-v" "${HOST_WORKSPACE_PATH}:${CONTAINER_WORKSPACE}")
    DOCKER_ARGS+=("-w" "${CONTAINER_WORKSPACE}")
    echo "🔴 安全风险: 映射模式 (直接挂载当前目录 ${HOST_WORKSPACE_PATH} -> /home/kali/workspace)"
elif [[ "$MOUNT_MODE" == "CUSTOM" ]]; then
    # 获取绝对路径
    HOST_WORKSPACE_PATH="$(cd "$MOUNT_DIR" 2>/dev/null && pwd || echo "$MOUNT_DIR")"
    if [[ ! -d "$HOST_WORKSPACE_PATH" ]]; then
        echo "❌ 错误: 指定的挂载目录不存在: $MOUNT_DIR" >&2
        exit 1
    fi
    DOCKER_ARGS+=("-v" "${HOST_WORKSPACE_PATH}:${CONTAINER_WORKSPACE}")
    DOCKER_ARGS+=("-w" "${CONTAINER_WORKSPACE}")
    echo "🟡 安全风险: 沙盒级别 (挂载指定目录 ${HOST_WORKSPACE_PATH} -> /home/kali/workspace)"
else
    DOCKER_ARGS+=("-w" "/home/kali")
    echo "🟢 安全风险: 隔离级别 (未挂载任何宿主机目录)"
fi

# 3. 塞入环境变量参数
if [[ ${#ENV_DOCKER_ARGS[@]} -gt 0 ]]; then
    DOCKER_ARGS+=("${ENV_DOCKER_ARGS[@]}")
fi

# 4. 指定镜像名称
DOCKER_ARGS+=("$DOCKER_IMAGE")

# 5. 指定要执行的命令
if [[ -n "$AGENT_CMD" ]]; then
    case "$AGENT_CMD" in
        claude|gemini|pi|codex|opencode)
            DOCKER_ARGS+=("/bin/zsh" "-lc" "${AGENT_CMD} ${EXTRA_ARGS[*]:-}")
            ;;
        *)
            # 允许运行任意指令
            DOCKER_ARGS+=("/bin/zsh" "-lc" "${AGENT_CMD} ${EXTRA_ARGS[*]:-}")
            ;;
    esac
else
    DOCKER_ARGS+=("/bin/zsh")
fi

# ─── 执行 ───────────────────────────────────────────────

if [[ "$DRY_RUN" == true ]]; then
    echo -e "\n🔍 Dry-run 模式，实际执行命令如下:"
    printf '%q ' "${DOCKER_ARGS[@]}"
    echo -e "\n"
    exit 0
fi

echo "🐳 正在拉起 AI Agent Docker 运行环境..."
exec "${DOCKER_ARGS[@]}"
